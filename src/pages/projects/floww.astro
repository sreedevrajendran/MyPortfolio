---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar';
import Footer from '../../components/Footer';

const project = {
  title: "Floww — AI Expense Tracker",
  description: "Floww is a smart personal finance app that uses AI to make money management completely effortless.",
  problemSolved: "Manual expense tracking is tedious and most users abandon budgeting apps after a few weeks. Floww eliminates this friction by leveraging OCR and Gemini 2.5 to instantly parse receipts, and automatically syncing with Gmail to categorize email-based transactions. It acts as an intelligent financial engine rather than just a logging tool.",
  techStack: ["AI", "React", "Firebase", "Netlify", "Gmail API", "Gemini 2.5"],
  demo: "https://flowwexpensetracker.netlify.app/login?callbackUrl=%2F",
  github: "https://github.com/sreedevrajendran/floww",
  screenshots: [
    "https://placehold.co/800x450/1a1a1a/4af626?text=App+Screenshot+1",
    "https://placehold.co/800x450/1a1a1a/8ab4f8?text=App+Screenshot+2"
  ],
};
---

<Layout
  title={`${project.title} | Projects | Sreedev Rajendran`}
  description={project.description}
  url="https://sreedevrajendran.in/projects/floww"
>
  <main class="flex flex-col w-full">
    <Navbar client:load />
    <div class="max-w-4xl mx-auto px-4 md:px-8 w-full flex flex-col pb-24 pt-32 font-mono">
      <div class="mb-12">
        <a href="/projects" class="text-[#4af626] hover:underline mb-6 inline-block font-bold">&larr; Back to Projects</a>
        <h1 class="text-4xl md:text-5xl font-bold mb-6 text-white">{project.title}</h1>
        <p class="text-xl text-[#888] leading-relaxed mb-8">{project.description}</p>
        
        <div class="flex flex-wrap gap-4">
          <a href={project.github} target="_blank" class="px-6 py-3 bg-[#1a1a1a] border border-[#333] hover:border-[#8ab4f8] hover:text-[#8ab4f8] rounded-lg transition-colors flex items-center gap-2 text-white font-bold text-sm">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" /></svg>
            GitHub Repository
          </a>
          {project.demo && (
            <a href={project.demo} target="_blank" class="px-6 py-3 bg-[#4af626]/10 border border-[#4af626]/40 hover:bg-[#4af626]/20 rounded-lg transition-colors flex items-center gap-2 text-[#4af626] font-bold text-sm">
              &rarr; Live Demo
            </a>
          )}
        </div>
      </div>

      <div class="space-y-8">
        <section class="bg-[#0a0a0a] border border-[#333] p-8 rounded-xl">
          <h2 class="text-2xl font-bold mb-4 text-[#8ab4f8]">Problem Solved</h2>
          <p class="text-[#999] leading-relaxed text-sm md:text-base">{project.problemSolved}</p>
        </section>

        <section class="bg-[#0a0a0a] border border-[#333] p-8 rounded-xl">
          <h2 class="text-2xl font-bold mb-4 text-[#ffbd2e]">Tech Stack</h2>
          <div class="flex flex-wrap gap-3">
            {project.techStack.map(tech => (
              <span class="px-4 py-2 bg-[#1a1a1a] border border-[#333] rounded-lg text-sm text-white">{tech}</span>
            ))}
          </div>
        </section>
        
        <section class="bg-[#0a0a0a] border border-[#333] p-8 rounded-xl">
          <h2 class="text-2xl font-bold mb-6 text-[#4af626]">Screenshots</h2>
          {project.screenshots && project.screenshots.length > 0 ? (
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              {project.screenshots.map(screenshot => (
                <div class="aspect-video bg-[#1a1a1a] border border-[#333] rounded-xl overflow-hidden flex items-center justify-center">
                   <img src={screenshot} alt="Project Screenshot" class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" />
                </div>
              ))}
            </div>
          ) : (
            <div class="aspect-video bg-[#1a1a1a] border border-[#333] rounded-xl flex items-center justify-center">
              <p class="text-[#666]">Screenshots coming soon.</p>
            </div>
          )}
        </section>
      </div>
    </div>
    <Footer />
  </main>
</Layout>
